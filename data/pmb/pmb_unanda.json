    "steps": [
      "Pilih jalur pendaftaran sesuai pilihan dan ketentuan kampus",
      "Isi formulir pendaftaran secara online di pmb.unanda.ac.id",
      "Lakukan pembayaran biaya pendaftaran melalui rekening atau metode yang ditentukan",
      "Siapkan dan unggah dokumen yang diperlukan (KTP/SIM/Paspor, pas foto, ijazah/SKL, Kartu Keluarga, bukti pembayaran)",
      "Ikuti tahapan seleksi sesuai jadwal dan petunjuk pihak kampus"
    ],
    "required_documents": [
      "KTP/SIM/Passport",
      "Pas foto 3×4 dan 2×3 (berpakaian formal latar belakang merah)",
